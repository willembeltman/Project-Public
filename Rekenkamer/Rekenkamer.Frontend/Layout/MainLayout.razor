@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IAuthenticatedHttpClient httpClient

<div class="d-flex flex-column min-vh-100 bg-light">
    <!-- Officiële Overheids-Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm border-bottom border-warning border-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
                <i class="bi bi-shield-shaded me-2"></i> DocumentenPortaal
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Navigatie in- of uitklappen">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (State?.User != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/DocumentOverview"><i class="bi bi-file-earmark-text me-1"></i> Alle documenten</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/VectorSearch"><i class="bi bi-search-heart me-1"></i> Vector zoeken</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/Manage"><i class="bi bi-pencil-square me-1"></i> Bewerken</a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center">
                    @if (State?.User != null)
                    {
                        <div class="text-light me-3 d-none d-md-block small">
                            <i class="bi bi-person-circle me-1"></i> Welkom, <strong>@State.User.UserName</strong>
                        </div>
                        <a class="btn btn-outline-light btn-sm px-3 rounded-pill" href="/Account/Index">
                            <i class="bi bi-gear-fill me-1"></i> Mijn account
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm px-3 rounded-pill fw-semibold text-primary" href="/Account/Index">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Inloggen / Registreren
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Hoofdinhoud: flex-grow-1 duwt de footer naar beneden -->
    <main class="container my-4 flex-grow-1 d-flex flex-column">
        <div class="card shadow-sm border-0 p-4 bg-white rounded-3 flex-grow-1">
            @Body
        </div>
    </main>

    <!-- Officiële Footer -->
    <footer class="py-3 bg-dark text-light border-top border-secondary mt-auto">
        <div class="container text-center small text-muted">
            &copy; 2026 - Rijksoverheid Demo-applicatie &middot; <a href="/Privacy" class="text-decoration-none text-muted">Privacy &amp; Voorwaarden</a>
        </div>
    </footer>
</div>

@code {
    private CancellationTokenSource? Cts;

    public State? State { get; private set; }

    protected override async Task OnInitializedAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();
        State = await httpClient.GetStateAsync(false, Cts.Token);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
    }
}
