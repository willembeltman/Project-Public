@page "/documentchunks/delete/{id?}"
@implements IAsyncDisposable
@inject IDocumentChunksApi iDocumentChunksApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete DocumentChunk</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete DocumentChunk</h3>
        <LoaderView Response="DocumentChunk?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this DocumentChunk
            </div>

            <AutoDocumentChunkDetails DataSource="DocumentChunk" />
            <ErrorView Response="DocumentChunk!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="DocumentChunk.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="DocumentChunk.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<DocumentChunk, Guid>? DocumentChunk;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        DocumentChunk = new ItemDataSource<DocumentChunk, Guid>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/documentchunks"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/documentchunks"),
            Create: null,
            Read: iDocumentChunksApi.Read,
            Update: null,
            Delete: iDocumentChunksApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );

        await DocumentChunk.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (DocumentChunk != null) 
            await DocumentChunk.DisposeAsync();
    }
}