@page "/DocumentOverview"
@implements IAsyncDisposable
@inject IDocumentsApi documentsApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS

<PageTitle>Documentenbibliotheek</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container-fluid py-4">

            <!-- Fancy Overheids-Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 border-bottom pb-3">
                <div class="d-flex align-items-center">
                    <div class="bg-primary text-white p-2 rounded-3 me-3 shadow-sm">
                        <i class="bi bi-file-earmark-text-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold text-dark">Documentenbibliotheek</h3>
                        <small class="text-muted">Volledig overzicht van geïndexeerde bestanden binnen het portaal</small>
                    </div>
                </div>

                <!-- Vervangende live status-indicator (veilig voor Lazy Loading) -->
                <div>
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2 rounded-pill small d-flex align-items-center gap-1">
                        <span class="spinner-grow spinner-grow-sm text-success me-1" role="status" style="width: 0.6rem; height: 0.6rem;"></span>
                        Opslag verbonden
                    </span>
                </div>
            </div>

            <!-- De Lijstweergave -->
            <div class="card shadow-sm border-0 bg-white rounded-3">
                <div class="card-body p-4">
                    <LoaderView Response="Documents?.Response">
                        <AutoDocumentList DataSource="Documents" />
                    </LoaderView>
                </div>
            </div>

        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource? Cts;
    private ListDataSource<Document, Guid>? Documents;

    protected override async Task OnInitializedAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false)
        {
            return;
        }

        Documents = new ListDataSource<Document, Guid>(
            JS,
            StateHasChanged,
            GetPrimaryKey: document => document.Id,
            List: async (skip, take, orderby, ct) =>
            {
                var response = await documentsApi.List(skip, take, orderby, ct);
                if (response.Success == false || response.Response == null)
                    return response;
                return new BaseListResponseT<Document>()
                {
                    Success = true,
                    Response = response.Response
                        .Select(a => new Document()
                        {
                            Id = a.Id,
                            CreatedAt = a.CreatedAt,
                            FullName = a.FullName,
                            RelativePath = a.RelativePath,
                            Size = a.Size
                        })
                        .ToArray()
                };
            },
            SetForeignKey: null,
            AfterSaveAction: null,
            AfterCancelAction: null,
            Create: null,
            Read: null,
            Update: null,
            Delete: null
        );

        await Documents.InitialiseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Documents != null)
            await Documents.DisposeAsync();
    }
}
