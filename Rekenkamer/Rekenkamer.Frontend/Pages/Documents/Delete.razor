@page "/documents/delete/{id?}"
@implements IAsyncDisposable
@inject IDocumentsApi iDocumentsApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete Document</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete Document</h3>
        <LoaderView Response="Document?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this Document
            </div>

            <AutoDocumentDetails DataSource="Document" />
            <ErrorView Response="Document!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="Document.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="Document.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<Document, Guid>? Document;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        Document = new ItemDataSource<Document, Guid>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/documents"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/documents"),
            Create: null,
            Read: iDocumentsApi.Read,
            Update: null,
            Delete: iDocumentsApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );

        await Document.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Document != null) 
            await Document.DisposeAsync();
    }
}