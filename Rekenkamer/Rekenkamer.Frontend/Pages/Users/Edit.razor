@page "/users/edit/{id?}"
@implements IAsyncDisposable
@inject IUsersApi iUsersApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Edit User</PageTitle>

<AuthorizeView>
    <Authorized Context="_">
        <h3>Edit User</h3>
        <LoaderView Response="User?.Response">
            <EditForm Model="User!.Model" OnValidSubmit="User.HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <AutoUserForm DataSource="User" />
                <ErrorView Response="User.StatusResponse" />
                <button id="save" class="btn btn-primary" type="submit">💾 Save</button>
                <button id="cancel" class="btn btn-secondary ms-2" @onclick="User.Cancel">Cancel</button>
            </EditForm>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<User, Guid>? User;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        User = new ItemDataSource<User, Guid>(
            GetPrimaryKey: e => e.Id,
            AfterSaveAction: e => NavigationManager.NavigateTo("/users"),
            AfterCancelAction: e => NavigationManager.NavigateTo("/users"),
            Create: iUsersApi.Create,
            Read: iUsersApi.Read,
            Update: iUsersApi.Update,
            Delete: iUsersApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );
        await User.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (User != null) 
            await User.DisposeAsync();
    }
}