@if (DataSource?.Model == null)
{
    <text><!-- niets te tonen --></text>
}
else
{    
    
    
    <div class="mb-2">
        <strong>Id</strong>: @(DataSource.Model.Id.ToString())
    </div>

    <div class="mb-2">
        <strong>MatchName</strong>: @(DataSource.Model.MatchName?.ToString())
    </div>

    <div class="mb-2">
        <strong>ProfileSenderName</strong>: @(DataSource.Model.ProfileSenderName?.ToString())
    </div>

    <div class="mb-2">
        <strong>ProfileReceiverName</strong>: @(DataSource.Model.ProfileReceiverName?.ToString())
    </div>

    <div class="mb-2">
        <strong>Date</strong>: @(DataSource.Model.Date.ToString())
    </div>

    <div class="mb-2">
        <strong>Message</strong>: @(DataSource.Model.Message.ToString())
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ItemDataSource<ChatMessage, Guid>? DataSource { get; set; }
}