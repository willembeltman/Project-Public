@if (DataSource?.Model == null)
{
    <text><!-- niets te renderen --></text>
}
else
{

    @if (HideColumnNames.Contains("MatchId") == false)
    {
        <div class="mb-3">
            <label for="matchId" class="form-label">Match</label>
            <MatchDropDown @bind-Value="DataSource.Model.MatchId" bindtype_Value="Guid"
                @bind-ForeignName="DataSource.Model.MatchName" bindtype_ForeignName="string?"
                DataSource="MatchIds" id="matchId" />
        </div>
    }

    @if (HideColumnNames.Contains("ProfileSenderId") == false)
    {
        <div class="mb-3">
            <label for="profileSenderId" class="form-label">Profile</label>
            <ProfileDropDown @bind-Value="DataSource.Model.ProfileSenderId" bindtype_Value="Guid"
                @bind-ForeignName="DataSource.Model.ProfileSenderName" bindtype_ForeignName="string?"
                DataSource="ProfileSenderIds" id="profileSenderId" />
        </div>
    }

    @if (HideColumnNames.Contains("ProfileReceiverId") == false)
    {
        <div class="mb-3">
            <label for="profileReceiverId" class="form-label">Profile</label>
            <ProfileDropDown @bind-Value="DataSource.Model.ProfileReceiverId" bindtype_Value="Guid"
                @bind-ForeignName="DataSource.Model.ProfileReceiverName" bindtype_ForeignName="string?"
                DataSource="ProfileReceiverIds" id="profileReceiverId" />
        </div>
    }

    @if (HideColumnNames.Contains("Date") == false)
    {
        <div class="mb-3">
            <label for="date" class="form-label">Date</label>
            <InputDate @bind-Value="DataSource.Model.Date" bindtype_Value="DateTimeOffset"
                id="date" class="form-control" />
        </div>
    }

    @if (HideColumnNames.Contains("Message") == false)
    {
        <div class="mb-3">
            <label for="message" class="form-label">Message</label>
            <InputText @bind-Value="DataSource.Model.Message" bindtype_Value="string"
                id="message" class="form-control" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public ItemDataSource<ChatMessage, Guid>? DataSource { get; set; }

    [Parameter, EditorRequired]
    public ListDataSource<Match, Guid> MatchIds { get; set; } = null!;
    [Parameter, EditorRequired]
    public ListDataSource<Profile, Guid> ProfileSenderIds { get; set; } = null!;
    [Parameter, EditorRequired]
    public ListDataSource<Profile, Guid> ProfileReceiverIds { get; set; } = null!;

    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }
}