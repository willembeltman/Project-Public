@if (DataSource == null || DataSource.Items.Count == 0)
{
    @if (DataSource == null || DataSource.HasMore == false)
    {
        <p><em>@(NoItemsText)</em></p>
    }
    else
    {
        <p><em>@(LoadingText)</em></p>
    }
}
else
{
    <div id="@(Id)">
        <!-- Desktop -->
        <div class="d-none d-md-block">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th></th>
                    @if (!HideColumnNames.Contains("Date"))
                    {
                        <th>
                            <a @onclick="OrderByDateClicked" style="cursor:pointer;">
                                Date
                                @if (DataSource.OrderByColumn == "Date asc") { <span>▲</span> }
                                else if (DataSource.OrderByColumn == "Date desc") { <span>▼</span> }
                            </a>
                        </th>
                    }
                    @if (!HideColumnNames.Contains("Message"))
                    {
                        <th>
                            <a @onclick="OrderByMessageClicked" style="cursor:pointer;">
                                Message
                                @if (DataSource.OrderByColumn == "Message asc") { <span>▲</span> }
                                else if (DataSource.OrderByColumn == "Message desc") { <span>▼</span> }
                            </a>
                        </th>
                    }
                    @if (!HideColumnNames.Contains("MatchName"))
                    {
                        <th>
                            <a @onclick="OrderByMatchNameClicked" style="cursor:pointer;">
                                MatchName
                                @if (DataSource.OrderByColumn == "MatchName asc") { <span>▲</span> }
                                else if (DataSource.OrderByColumn == "MatchName desc") { <span>▼</span> }
                            </a>
                        </th>
                    }
                    @if (!HideColumnNames.Contains("ProfileSenderName"))
                    {
                        <th>
                            <a @onclick="OrderByProfileSenderNameClicked" style="cursor:pointer;">
                                ProfileSenderName
                                @if (DataSource.OrderByColumn == "ProfileSenderName asc") { <span>▲</span> }
                                else if (DataSource.OrderByColumn == "ProfileSenderName desc") { <span>▼</span> }
                            </a>
                        </th>
                    }
                    @if (!HideColumnNames.Contains("ProfileReceiverName"))
                    {
                        <th>
                            <a @onclick="OrderByProfileReceiverNameClicked" style="cursor:pointer;">
                                ProfileReceiverName
                                @if (DataSource.OrderByColumn == "ProfileReceiverName asc") { <span>▲</span> }
                                else if (DataSource.OrderByColumn == "ProfileReceiverName desc") { <span>▼</span> }
                            </a>
                        </th>
                    }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DataSource.Items)
                    {
                        <tr>
                            <td>
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => SelectItem(item)">
                                    @(SelectText)
                                </button>
                            </td>
                    @if (!HideColumnNames.Contains("Date"))
                    {
                        <td>@(item.Model!.Date)</td>
                    }
                    @if (!HideColumnNames.Contains("Message"))
                    {
                        <td>@(item.Model!.Message)</td>
                    }
                    @if (!HideColumnNames.Contains("MatchName"))
                    {
                        <td>@(item.Model!.MatchName)</td>
                    }
                    @if (!HideColumnNames.Contains("ProfileSenderName"))
                    {
                        <td>@(item.Model!.ProfileSenderName)</td>
                    }
                    @if (!HideColumnNames.Contains("ProfileReceiverName"))
                    {
                        <td>@(item.Model!.ProfileReceiverName)</td>
                    }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile -->
        <div class="d-md-none">
            <div class="mb-2 d-flex gap-2 align-items-center">
                <select @onchange="DataSource.OrderByChanged" class="form-select form-select-sm w-auto">
                @if (Nothing__Selected)
                {
                    <option value="" selected>@(EmptyText)</option>
                }
                else
                {
                    <option value="">@(EmptyText)</option>
                }

                
                @if (HideColumnNames.Contains("Date") == false)
                {
                    @if (Date__Selected)
                    {
                        <option value="Date" selected>Date</option>
                    }
                    else
                    {
                        <option value="Date">Date</option>
                    }
                }
                @if (HideColumnNames.Contains("Message") == false)
                {
                    @if (Message__Selected)
                    {
                        <option value="Message" selected>Message</option>
                    }
                    else
                    {
                        <option value="Message">Message</option>
                    }
                }
                @if (HideColumnNames.Contains("MatchName") == false)
                {
                    @if (MatchName__Selected)
                    {
                        <option value="MatchName" selected>MatchName</option>
                    }
                    else
                    {
                        <option value="MatchName">MatchName</option>
                    }
                }
                @if (HideColumnNames.Contains("ProfileSenderName") == false)
                {
                    @if (ProfileSenderName__Selected)
                    {
                        <option value="ProfileSenderName" selected>ProfileSenderName</option>
                    }
                    else
                    {
                        <option value="ProfileSenderName">ProfileSenderName</option>
                    }
                }
                @if (HideColumnNames.Contains("ProfileReceiverName") == false)
                {
                    @if (ProfileReceiverName__Selected)
                    {
                        <option value="ProfileReceiverName" selected>ProfileReceiverName</option>
                    }
                    else
                    {
                        <option value="ProfileReceiverName">ProfileReceiverName</option>
                    }
                }
            </select>

            @if (!string.IsNullOrEmpty(DataSource.OrderByColumn))
            {
                <select @onchange="DataSource.OrderByDirectionChanged" class="form-select form-select-sm w-auto">
                    @if (DataSource.OrderByDirectionAsc)
                    {
                        <option value="false" selected>@(AscText)</option>
                        <option value="true">@(DescText)</option>
                    }
                    else
                    {
                        <option value="false">@(AscText)</option>
                        <option value="true" selected>@(DescText)</option>
                    }
                </select>
            }
            </div>

            <div class="row row-cols-1 g-2">
                @foreach (var item in DataSource.Items)
                {
                    <div class="col">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <div class="d-flex align-items-center">
                                    @if (!HideColumnNames.Contains("Date"))
                                    {
                                        <div class="text-muted">@(item.Model!.Date)</div>
                                    }
                                    @if (!HideColumnNames.Contains("Message"))
                                    {
                                        <div class="text-muted">@(item.Model!.Message)</div>
                                    }
                                    @if (!HideColumnNames.Contains("MatchName"))
                                    {
                                        <div class="text-muted">@(item.Model!.MatchName)</div>
                                    }
                                    @if (!HideColumnNames.Contains("ProfileSenderName"))
                                    {
                                        <div class="text-muted">@(item.Model!.ProfileSenderName)</div>
                                    }
                                    @if (!HideColumnNames.Contains("ProfileReceiverName"))
                                    {
                                        <div class="text-muted">@(item.Model!.ProfileReceiverName)</div>
                                    }
                                </div>
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-outline-primary w-100"
                                            @onclick="() => SelectItem(item)">
                                        @(SelectText)
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    @if (DataSource.HasMore)
    {
        <div id="@(DataSource.SentinelId)" class="sentinel">
            @(LoadingModeText)
        </div>
    }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ListDataSource<ChatMessage, Guid>? DataSource { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<ItemDataSource<ChatMessage, Guid>> OnSelect { get; set; }

    [Parameter] public string Id { get; set; } = $"chatmessageSelectList_{Guid.NewGuid()}";
    [Parameter] public string SelectText { get; set; } = "Select";
    [Parameter] public string EmptyText { get; set; } = "Order by...";
    [Parameter] public string AscText { get; set; } = "▲ asc";
    [Parameter] public string DescText { get; set; } = "▼ desc";
    [Parameter] public string LoadingModeText { get; set; } = "Loading more...";
    [Parameter] public string LoadingText { get; set; } = "Loading, please wait...";
    [Parameter] public string NoItemsText { get; set; } = "No ChatMessages to select.";

    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (//!firstRender || 
            DataSource == null)
            return;
        await DataSource.AfterRenderAsync();
    }

    private async Task SelectItem(ItemDataSource<ChatMessage, Guid> item)
    {
        if (OnSelect.HasDelegate)
            await OnSelect.InvokeAsync(item);
    }
    
    private async Task OrderByDateClicked()
    {
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Date");
    }
    private async Task OrderByMessageClicked()
    {
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Message");
    }
    private async Task OrderByMatchNameClicked()
    {
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("MatchName");
    }
    private async Task OrderByProfileSenderNameClicked()
    {
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("ProfileSenderName");
    }
    private async Task OrderByProfileReceiverNameClicked()
    {
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("ProfileReceiverName");
    }

    private bool Nothing__Selected => string.IsNullOrEmpty(DataSource?.OrderByColumn);
    private bool Date__Selected => DataSource?.OrderByColumn == "Date";
    private bool Message__Selected => DataSource?.OrderByColumn == "Message";
    private bool MatchName__Selected => DataSource?.OrderByColumn == "MatchName";
    private bool ProfileSenderName__Selected => DataSource?.OrderByColumn == "ProfileSenderName";
    private bool ProfileReceiverName__Selected => DataSource?.OrderByColumn == "ProfileReceiverName";
}