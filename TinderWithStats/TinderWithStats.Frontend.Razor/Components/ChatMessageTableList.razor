@code {
    [Parameter, EditorRequired]
    public ListDataSource<ChatMessage, Guid>? DataSource { get; set; }

    [Parameter] public string Id { get; set; } = $"chatmessageTableList_{Guid.NewGuid()}";
    [Parameter] public string EmptyText { get; set; } = "Order by...";
    [Parameter] public string AscText { get; set; } = "▲ asc";
    [Parameter] public string DescText { get; set; } = "▼ desc";
    [Parameter] public string EditText { get; set; } = "✏️ Edit";
    [Parameter] public string DeleteText { get; set; } = "🗑️ Delete";
    [Parameter] public string LoadingText { get; set; } = "Loading, please wait...";
    [Parameter] public string LoadingModeText { get; set; } = "Loading more...";
    [Parameter] public string NoItemsText { get; set; } = "No ChatMessages to display.";
    
    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (//!firstRender || 
            DataSource == null)
            return;
        await DataSource.AfterRenderAsync();
    }


    private async Task OrderByIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Id");
    }
    private async Task OrderByDateClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Date");
    }
    private async Task OrderByMessageClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Message");
    }
    private async Task OrderByMatchNameClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("MatchName");
    }
    private async Task OrderByProfileSenderNameClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("ProfileSenderName");
    }
    private async Task OrderByProfileReceiverNameClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("ProfileReceiverName");
    }
    private async Task OrderByMatchIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("MatchId");
    }
    private async Task OrderByProfileSenderIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("ProfileSenderId");
    }
    private async Task OrderByProfileReceiverIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("ProfileReceiverId");
    }
    private async Task OrderByCanUpdateClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("CanUpdate");
    }
    private async Task OrderByCanDeleteClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("CanDelete");
    }

    private bool Nothing__Selected => string.IsNullOrEmpty(DataSource?.OrderByColumn);
    private bool Id__Selected => DataSource?.OrderByColumn == "Id";
    private bool Date__Selected => DataSource?.OrderByColumn == "Date";
    private bool Message__Selected => DataSource?.OrderByColumn == "Message";
    private bool MatchName__Selected => DataSource?.OrderByColumn == "MatchName";
    private bool ProfileSenderName__Selected => DataSource?.OrderByColumn == "ProfileSenderName";
    private bool ProfileReceiverName__Selected => DataSource?.OrderByColumn == "ProfileReceiverName";
    private bool MatchId__Selected => DataSource?.OrderByColumn == "MatchId";
    private bool ProfileSenderId__Selected => DataSource?.OrderByColumn == "ProfileSenderId";
    private bool ProfileReceiverId__Selected => DataSource?.OrderByColumn == "ProfileReceiverId";
    private bool CanUpdate__Selected => DataSource?.OrderByColumn == "CanUpdate";
    private bool CanDelete__Selected => DataSource?.OrderByColumn == "CanDelete";
}