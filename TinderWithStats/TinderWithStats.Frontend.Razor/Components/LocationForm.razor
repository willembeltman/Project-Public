@if (DataSource?.Model == null)
{
    <text><!-- niets te renderen --></text>
}
else
{

    @if (HideColumnNames.Contains("LocationName") == false)
    {
        <div class="mb-3">
            <label for="locationName" class="form-label">LocationName</label>
            <InputText @bind-Value="DataSource.Model.LocationName" bindtype_Value="string"
                id="locationName" class="form-control" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public ItemDataSource<Location, int>? DataSource { get; set; }


    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }
}