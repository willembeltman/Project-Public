@if (DataSource?.Model == null)
{
    <text><!-- niets te tonen --></text>
}
else
{    
    
    
    <div class="mb-2">
        <strong>Id</strong>: @(DataSource.Model.Id.ToString())
    </div>

    <div class="mb-2">
        <strong>UserName</strong>: @(DataSource.Model.UserName?.ToString())
    </div>

    <div class="mb-2">
        <strong>LocationName</strong>: @(DataSource.Model.LocationName?.ToString())
    </div>

    <div class="mb-2">
        <strong>Name</strong>: @(DataSource.Model.Name.ToString())
    </div>

    <div class="mb-2">
        <strong>DateOfBirth</strong>: @(DataSource.Model.DateOfBirth.ToString())
    </div>

    <div class="mb-2">
        <strong>Length</strong>: @(DataSource.Model.Length.ToString())
    </div>

    <div class="mb-2">
        <strong>Beroep</strong>: @(DataSource.Model.Beroep.ToString())
    </div>

    <div class="mb-2">
        <strong>Bio</strong>: @(DataSource.Model.Bio.ToString())
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ItemDataSource<Profile, Guid>? DataSource { get; set; }
}