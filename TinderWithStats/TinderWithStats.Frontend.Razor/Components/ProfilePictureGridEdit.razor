@if (DataSource == null || DataSource.Items.Count == 0)
{
    @if (DataSource == null || DataSource.HasMore)
    {
        <p><em>@(LoadingText)</em></p>
    }
    else
    {
        <p><em>@(NoItemsText)</em></p>
    }
}
else
{
    <div class="grid-container" id="@(Id)"
         style="width:100%; max-height:250px; overflow:auto;">
         
        <div class="grid-row">
            <div class="grid-header">File</div>
            @if (HideColumnNames.Contains("ProfileId") == false)
            {
                <div class="grid-header">ProfileId</div>
            }
            @if (HideColumnNames.Contains("UploadDate") == false)
            {
                <div class="grid-header">UploadDate</div>
            }
            <div class="grid-header">Actions</div>
        </div>

        @foreach (var item in DataSource.Items)
        {
            <EditForm Model="item.Model" OnValidSubmit="() => DataSource.HandleValidSubmit(item)">
                <DataAnnotationsValidator />
                <div class="grid-row">
                    <div class="grid-cell">
                        @if (!string.IsNullOrWhiteSpace(item.Model!.StorageFileUrl))
                        {
                            <div class="storageFilePreview">
                                <img src="@(item.Model!.StorageFileUrl)" style="max-width: 100px;" />
                                <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => DataSource.OnHandleFileRemoved(item)">❌ Remove</button>
                            </div>
                        }
                        <div class="storageFile">
                            <InputFile OnChange="(e) => DataSource.OnHandleFileSelected(item, e)" key="item.File.FileInputKey" />
                            @if (item.File != null)
                            {
                                <div class="storageFileUploadPreview">
                                    <span>📄 @(item.File.FileName)</span>
                                    <button type="button" class="btn btn-sm btn-link text-danger" @onclick="() => DataSource.OnCancelFileSelected(item)">❌ Remove</button>
                                </div>
                            }
                        </div>
                    </div>
                    @if (HideColumnNames.Contains("ProfileId") == false)
                    {
                        <div class="grid-cell">
                            <ProfileDropDown 
                                @bind-Value="item.Model!.ProfileId" bindtype_Value="Guid"
                                @bind-ForeignName="item.Model!.ProfileName" bindtype_ForeignName="string?" 
                                DataSource="Profiles" />
                        </div>
                    }
                    @if (HideColumnNames.Contains("UploadDate") == false)
                    {
                        <div class="grid-cell">
                            <InputDate @bind-Value="item.Model!.UploadDate" bindtype_Value="DateTimeOffset" class="form-control" />
                        </div>
                    }
                    <div class="grid-cell">
                        <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                    </div>
                </div>
            </EditForm>
        }

        @if (DataSource.HasMore)
        {
            <div id="@(DataSource.SentinelId)" class="sentinel">@(LoadingMoreText)</div>
        }
    </div>
}

<style>
    .grid-container {
    }

    .grid-row {
        font-size: 9px;
    }

    .grid-header {
        font-weight: bold;
        border-bottom: 1px solid #ccc;
        padding: 4px;
        display: inline-block;
        width: 100px;
    }

    .grid-cell {
        border-bottom: 1px solid #ddd;
        padding: 4px;
        display: inline-block;
        width: 100px;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public ListDataSource<ProfilePicture, Guid>? DataSource { get; set; }

    [Parameter, EditorRequired]
    public ListDataSource<Profile, Guid>? Profiles { get; set; }

    [Parameter] public string Id { get; set; } = $"profilepictureGridEdit_{Guid.NewGuid()}";
    [Parameter] public string LoadingText { get; set; } = "Loading, please wait...";
    [Parameter] public string LoadingMoreText { get; set; } = "Loading more...";
    [Parameter] public string NoItemsText { get; set; } = "No ProfilePictures to display.";

    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (//!firstRender || 
            DataSource == null)
            return;
        await DataSource.AfterRenderAsync();
    }
}