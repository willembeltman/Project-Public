@code {
    [Parameter, EditorRequired]
    public ListDataSource<Profile, Guid>? DataSource { get; set; }

    [Parameter] public string Id { get; set; } = $"profileTableList_{Guid.NewGuid()}";
    [Parameter] public string EmptyText { get; set; } = "Order by...";
    [Parameter] public string AscText { get; set; } = "▲ asc";
    [Parameter] public string DescText { get; set; } = "▼ desc";
    [Parameter] public string EditText { get; set; } = "✏️ Edit";
    [Parameter] public string DeleteText { get; set; } = "🗑️ Delete";
    [Parameter] public string LoadingText { get; set; } = "Loading, please wait...";
    [Parameter] public string LoadingModeText { get; set; } = "Loading more...";
    [Parameter] public string NoItemsText { get; set; } = "No Profiles to display.";
    
    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (//!firstRender || 
            DataSource == null)
            return;
        await DataSource.AfterRenderAsync();
    }


    private async Task OrderByIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Id");
    }
    private async Task OrderByNameClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Name");
    }
    private async Task OrderByDateOfBirthClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("DateOfBirth");
    }
    private async Task OrderByUserNameClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("UserName");
    }
    private async Task OrderByLocationNameClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("LocationName");
    }
    private async Task OrderByUserIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("UserId");
    }
    private async Task OrderByLocationIdClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("LocationId");
    }
    private async Task OrderByLengthClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Length");
    }
    private async Task OrderByBeroepClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Beroep");
    }
    private async Task OrderByBioClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("Bio");
    }
    private async Task OrderByCanUpdateClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("CanUpdate");
    }
    private async Task OrderByCanDeleteClicked()
    { 
        if (DataSource != null)
            await DataSource.OrderByColumnClicked("CanDelete");
    }

    private bool Nothing__Selected => string.IsNullOrEmpty(DataSource?.OrderByColumn);
    private bool Id__Selected => DataSource?.OrderByColumn == "Id";
    private bool Name__Selected => DataSource?.OrderByColumn == "Name";
    private bool DateOfBirth__Selected => DataSource?.OrderByColumn == "DateOfBirth";
    private bool UserName__Selected => DataSource?.OrderByColumn == "UserName";
    private bool LocationName__Selected => DataSource?.OrderByColumn == "LocationName";
    private bool UserId__Selected => DataSource?.OrderByColumn == "UserId";
    private bool LocationId__Selected => DataSource?.OrderByColumn == "LocationId";
    private bool Length__Selected => DataSource?.OrderByColumn == "Length";
    private bool Beroep__Selected => DataSource?.OrderByColumn == "Beroep";
    private bool Bio__Selected => DataSource?.OrderByColumn == "Bio";
    private bool CanUpdate__Selected => DataSource?.OrderByColumn == "CanUpdate";
    private bool CanDelete__Selected => DataSource?.OrderByColumn == "CanDelete";
}