@if (DataSource?.Model == null)
{
    <text><!-- niets te renderen --></text>
}
else
{

    @if (HideColumnNames.Contains("UserName") == false)
    {
        <div class="mb-3">
            <label for="userName" class="form-label">UserName</label>
            <InputText @bind-Value="DataSource.Model.UserName" bindtype_Value="string"
                id="userName" class="form-control" />
        </div>
    }

    @if (HideColumnNames.Contains("Email") == false)
    {
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText @bind-Value="DataSource.Model.Email" bindtype_Value="string"
                id="email" class="form-control" />
        </div>
    }

    @if (HideColumnNames.Contains("PhoneNumber") == false)
    {
        <div class="mb-3">
            <label for="phoneNumber" class="form-label">PhoneNumber</label>
            <InputText @bind-Value="DataSource.Model.PhoneNumber" bindtype_Value="string"
                id="phoneNumber" class="form-control" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired]
    public ItemDataSource<User, Guid>? DataSource { get; set; }


    private string[] HideColumnNames = [];

    [Parameter]
    public string? HideColumns { get; set; }

    protected override void OnParametersSet()
    {
        HideColumnNames = string.IsNullOrWhiteSpace(HideColumns)
            ? []
            : HideColumns.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries
              );
    }
}