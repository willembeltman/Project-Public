@page "/Account/ChangePassword"
@implements IAsyncDisposable
@inject IAccountService Account
@inject NavigationManager NavigationManager

<PageTitle>Change password</PageTitle>
<h3>Change password</h3>

<AuthorizeView>
    <Authorized Context="_">

        <EditForm Model="this" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label>Old password</label>
                <InputText @bind-Value="OldPassword" type="password" class="form-control" />
            </div>
            <div class="mb-3">
                <label>New Password</label>
                <InputText @bind-Value="Password" type="password" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Repeat password</label>
                <InputText @bind-Value="PasswordRepeat" type="password" class="form-control" />
            </div>
            <ErrorView Response="Response" />
            <button type="submit" class="btn btn-primary">Change password</button>
        </EditForm>

        @if (Response != null && Response.Success)
        {
            <h3>Success</h3>
        }

    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource Cts = new();
    private string OldPassword { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string PasswordRepeat { get; set; } = string.Empty;
    private BaseResponse? Response { get; set; }

    private async Task HandleValidSubmit()
    {
        Response = await Account.ChangePasswordAsync(OldPassword, Password, PasswordRepeat, Cts.Token);
        if (!string.IsNullOrWhiteSpace(Response.RedirectPath))
        {
            NavigationManager.NavigateTo(Response.RedirectPath);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Cts.CancelAsync();
        Cts.Dispose();
    }
}