@page "/Account"
@inject IAuthenticatedHttpClient httpClient

<PageTitle>Account</PageTitle>
<h3>Account</h3>

<AuthorizeView>
    <Authorized Context="_">

        <div class="px-3">
            <a class="nav-link" href="@AccountUrl">
                <span aria-hidden="true"></span> Account information
            </a>
        </div>

        @if (ProfileId != null)
        {
            <div class="px-3">
                <a class="nav-link" href="@ProfileUrl">
                    <span aria-hidden="true"></span> Profile information
                </a>
            </div>
        }

        <div class="px-3">
            <NavLink class="nav-link" href="/Account/ChangePassword">
                <span aria-hidden="true"></span> Change password
            </NavLink>
        </div>

        <div class="px-3">
            <NavLink class="nav-link" href="/Account/Logoff">
                <span aria-hidden="true"></span> Log off
            </NavLink>
        </div>

    </Authorized>
    <NotAuthorized Context="_">

        <div class="px-3">
            <NavLink class="nav-link" href="/Account/Register">
                <span aria-hidden="true"></span> Register
            </NavLink>
        </div>
        <div class="px-3">
            <NavLink class="nav-link" href="/Account/Login">
                <span aria-hidden="true"></span> Log in
            </NavLink>
        </div>

    </NotAuthorized>
</AuthorizeView>

@code {
    private string? UserId;
    private string? ProfileId;

    private string? AccountUrl { get; set; }
    private string? ProfileUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await httpClient.GetStateAsync();
        UserId = state.User?.Id.ToString();
        ProfileId = state.ProfileId;

        AccountUrl = $"/Users/Edit/{UserId}"; 
        ProfileUrl = $"/Profiles/Edit/{ProfileId}";
    }
}