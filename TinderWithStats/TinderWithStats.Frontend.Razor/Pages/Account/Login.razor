@page "/Account/Login"
@implements IAsyncDisposable
@inject IAccountService Account
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>
<h3>Login</h3>

<AuthorizeView>
    <Authorized>
        <RedirectToHome />
    </Authorized>
    <NotAuthorized Context="_">

        <EditForm Model="this" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="mb-3">
                <label>E-mail</label>
                <InputText @bind-Value="Email" class="form-control" />
            </div>
            <div class="mb-3">
                <label>Password</label>
                <InputText @bind-Value="Password" type="password" class="form-control" />
            </div>
            <ErrorView Response="Response" />
            <button type="submit" class="btn btn-primary">Log in</button>
        </EditForm>

        @if (Response != null && Response.Success)
        {
            <h3>Success</h3>
        }

    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource Cts = new();
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private BaseResponse? Response { get; set; }

    private async Task HandleValidSubmit()
    {
        Response = await Account.LoginAsync(Email, Password, Cts.Token);
        if (!string.IsNullOrWhiteSpace(Response.RedirectPath))
        {
            NavigationManager.NavigateTo(Response.RedirectPath);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Cts.CancelAsync();
        Cts.Dispose();
    }
}