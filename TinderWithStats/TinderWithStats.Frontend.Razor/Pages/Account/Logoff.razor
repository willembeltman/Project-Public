@page "/Account/Logoff"
@implements IAsyncDisposable
@inject IAccountService Account
@inject NavigationManager NavigationManager

<PageTitle>Logoff</PageTitle>
<h3>Logoff</h3>

<AuthorizeView>
    <Authorized Context="_">


        <div>
            Waiting for server...
            <ErrorView Response="Response" />
        </div>

        @if (Response != null && Response.Success)
        {
            <h3>Success</h3>
        }

    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource Cts = new();
    private BaseResponse? Response { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await HandleValidSubmit();
    }

    private async Task HandleValidSubmit()
    {
        Response = await Account.LogoffAsync(Cts.Token);
        if (!string.IsNullOrWhiteSpace(Response.RedirectPath))
        {
            NavigationManager.NavigateTo(Response.RedirectPath);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Cts.CancelAsync();
        Cts.Dispose();
    }
}