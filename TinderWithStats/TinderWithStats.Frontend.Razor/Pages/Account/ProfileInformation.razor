@page "/Account/ProfileInformation"
@implements IAsyncDisposable
@inject IUsersApi iUsersApi
@inject ILocationsApi iLocationsApi
@inject IProfilesApi iProfilesApi
@inject IAuthenticatedHttpClient HttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Edit Profile</PageTitle>

<AuthorizeView>
    <Authorized Context="_">
        <h3>Edit Profile</h3>
        <LoaderView Response="Profile?.Response">
            <EditForm Model="Profile!.Model" OnValidSubmit="Profile.HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <ProfileForm DataSource="Profile" UserIds="UserIds" LocationIds="LocationIds" HideColumns="UserId" />
                <ErrorView Response="Profile.StatusResponse" />
                <button id="save" class="btn btn-primary" type="submit">💾 Save</button>
                <button id="cancel" class="btn btn-secondary ms-2" @onclick="Profile.Cancel">Cancel</button>
            </EditForm>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<Profile, Guid>? Profile;
    private ListDataSource<User, Guid>? UserIds;
    private ListDataSource<Location, int>? LocationIds;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        var state = await HttpClient.GetStateAsync(false, Cts.Token);
        if (state.User == null || state.ProfileId == null)
        {
            return;
        }

        Profile = new ItemDataSource<Profile, Guid>(
            GetPrimaryKey: e => e.Id,
            AfterSaveAction: e => NavigationManager.NavigateTo("/profiles"),
            AfterCancelAction: e => NavigationManager.NavigateTo("/profiles"),
            Create: null,
            Read: iProfilesApi.Read,
            Update: iProfilesApi.Update,
            Delete: null,
            FileUpdate: null,
            FileDelete: null
        );
        await Profile.LoadModelAsync(state.ProfileId);

        UserIds = new ListDataSource<User, Guid>(
            JS,
            StateHasChanged,
            GetPrimaryKey: x => x.Id,
            List: (int? skip, int? take, string[]? orderBy, CancellationToken ct) => iUsersApi.List(skip, take, orderBy, ct),
            SetForeignKey: null,
            AfterSaveAction: null,
            AfterCancelAction: null,
            Create: null,
            Read: iUsersApi.Read,
            Update: null,
            Delete: null
        );
        await UserIds.InitialiseAsync();

        LocationIds = new ListDataSource<Location, int>(
            JS,
            StateHasChanged,
            GetPrimaryKey: x => x.Id,
            List: (int? skip, int? take, string[]? orderBy, CancellationToken ct) => iLocationsApi.List(skip, take, orderBy, ct),
            SetForeignKey: null,
            AfterSaveAction: null,
            AfterCancelAction: null,
            Create: null,
            Read: iLocationsApi.Read,
            Update: null,
            Delete: null
        );
        await LocationIds.InitialiseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Profile != null) 
            await Profile.DisposeAsync();
        if (UserIds != null) 
            await UserIds.DisposeAsync();
        if (LocationIds != null) 
            await LocationIds.DisposeAsync();
    }
}