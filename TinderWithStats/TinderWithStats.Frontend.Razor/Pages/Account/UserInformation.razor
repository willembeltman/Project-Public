@page "/Account/UserInformation"
@implements IAsyncDisposable
@inject IUsersApi UsersApi
@inject IAuthenticatedHttpClient HttpClient
@inject NavigationManager NavigationManager

<PageTitle>Account information</PageTitle>
<h3>Account information</h3>

<AuthorizeView>
    <Authorized Context="_">
        <h3>Edit User</h3>
        <LoaderView Response="User?.Response">
            <EditForm Model="User!.Model" OnValidSubmit="User.HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <UserForm DataSource="User" />
                <ErrorView Response="User.StatusResponse" />
                <button id="save" class="btn btn-primary" type="submit">💾 Save</button>
                <button id="cancel" class="btn btn-secondary ms-2" @onclick="User.Cancel">Cancel</button>
            </EditForm>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource? Cts;
    private ItemDataSource<User, Guid>? User;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        var state = await HttpClient.GetStateAsync(false, Cts.Token);
        if (state.User == null)
        {
            return;
        }

        User = new ItemDataSource<User, Guid>(
            GetPrimaryKey: e => e.Id,
            AfterSaveAction: e => NavigationManager.NavigateTo("/Account"),
            AfterCancelAction: e => NavigationManager.NavigateTo("/Account"),
            Create: null,
            Read: UsersApi.Read,
            Update: UsersApi.Update,
            Delete: null,
            FileUpdate: null,
            FileDelete: null
        );
        await User.LoadModelAsync(state.User.Id);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (User != null)
            await User.DisposeAsync();
    }
}