@page "/chatmessages/delete/{id?}"
@implements IAsyncDisposable
@inject IChatMessagesApi iChatMessagesApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete ChatMessage</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete ChatMessage</h3>
        <LoaderView Response="ChatMessage?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this ChatMessage
            </div>

            <AutoChatMessageDetails DataSource="ChatMessage" />
            <ErrorView Response="ChatMessage!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="ChatMessage.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="ChatMessage.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<ChatMessage, Guid>? ChatMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        ChatMessage = new ItemDataSource<ChatMessage, Guid>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/chatmessages"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/chatmessages"),
            Create: null,
            Read: iChatMessagesApi.Read,
            Update: null,
            Delete: iChatMessagesApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );

        await ChatMessage.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (ChatMessage != null) 
            await ChatMessage.DisposeAsync();
    }
}