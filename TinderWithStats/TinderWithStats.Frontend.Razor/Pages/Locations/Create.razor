@page "/locations/create"
@implements IAsyncDisposable
@inject ILocationsApi iLocationsApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Create Location</PageTitle>

<AuthorizeView>
    <Authorized Context="_">
        <h3>Create Location</h3>
        <LoaderView Response="Location?.Response">
            <EditForm Model="Location!.Model" OnValidSubmit="Location.HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <LocationForm DataSource="Location" />
                <ErrorView Response="Location.StatusResponse" />
                <button id="create" class="btn btn-primary" type="submit">➕ Create</button>
                <button id="cancel" class="btn btn-secondary ms-2" @onclick="Location.Cancel">Cancel</button>
            </EditForm>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource? Cts;
    private ItemDataSource<Location, int>? Location;

    protected override async Task OnInitializedAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false)
            return;

        Location = new ItemDataSource<Location, int>(
            GetPrimaryKey: location => location.Id,
            AfterSaveAction: location => NavigationManager.NavigateTo("/locations"),
            AfterCancelAction: location => NavigationManager.NavigateTo("/locations"),
            Create: iLocationsApi.Create,
            Read: null,
            Update: null,
            Delete: null,
            FileUpdate: null,
            FileDelete: null
        );
        Location.NewModel();
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Location != null) 
            await Location.DisposeAsync();
    }
}