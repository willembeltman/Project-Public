@page "/matchs/delete/{id?}"
@implements IAsyncDisposable
@inject IMatchsApi iMatchsApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete Match</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete Match</h3>
        <LoaderView Response="Match?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this Match
            </div>

            <MatchDetails DataSource="Match" />
            <ErrorView Response="Match!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="Match.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="Match.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<Match, Guid>? Match;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        Match = new ItemDataSource<Match, Guid>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/matchs"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/matchs"),
            Create: null,
            Read: iMatchsApi.Read,
            Update: null,
            Delete: iMatchsApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );

        await Match.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Match != null) 
            await Match.DisposeAsync();
    }
}