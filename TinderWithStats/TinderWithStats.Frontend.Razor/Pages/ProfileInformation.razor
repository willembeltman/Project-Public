@page "/Manage/ProfileInformation"
@implements IAsyncDisposable
@inject IUsersApi UsersApi
@inject ILocationsApi LocationsApi
@inject IProfilesApi ProfilesApi
@inject IProfilePicturesApi ProfilePicturesApi
@inject IAuthenticatedHttpClient HttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Edit Profile</PageTitle>

<AuthorizeView>
    <Authorized Context="_">
        <h3>Edit Profile</h3>
        <LoaderView Response="Profile?.Response">
            <EditForm Model="Profile!.Model" OnValidSubmit="Profile.HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <AutoProfileForm DataSource="Profile" LocationIds="Locations" />
                <ErrorView Response="Profile.StatusResponse" />
                <button id="save" class="btn btn-primary" type="submit">💾 Save</button>
                <button id="cancel" class="btn btn-secondary ms-2" @onclick="Profile.Cancel">Cancel</button>
            </EditForm>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource? Cts;
    private ItemDataSource<Profile, Guid>? Profile;

    private ListDataSource<ProfilePicture, Guid>? ProfilePictures;
    private ListDataSource<Location, int>? Locations;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        Profile = new ItemDataSource<Profile, Guid>(
            GetPrimaryKey: e => e.Id,
            AfterSaveAction: e => NavigationManager.NavigateTo("/Manage"),
            AfterCancelAction: e => NavigationManager.NavigateTo("/Manage"),
            Create: null,
            Read: ProfilesApi.Read,
            Update: ProfilesApi.Update,
            Delete: null,
            FileUpdate: null,
            FileDelete: null
        );

        var state = await HttpClient.GetStateAsync(false, Cts.Token);
        if (state.User == null || state.ProfileId == null)
        {
            Profile.Response = new BaseResponseT<Profile>()
            {
                Error = gAPI.Core.Enums.BaseResponseErrorEnum.ErrorInApp
            };
            return;
        }

        await Profile.LoadModelAsync(state.ProfileId);


        ProfilePictures = new ListDataSource<ProfilePicture, Guid>(
            JS,
            StateHasChanged,
            GetPrimaryKey: profilepicture => profilepicture.Id,
            List: (skip, take, orderby, ct) => ProfilePicturesApi.ListByProfileId(state.ProfileId, skip, take, orderby, c),
            SetForeignKey: null,
            AfterSaveAction: null,
            AfterCancelAction: null,
            Create: null,
            Read: null,
            Update: null,
            Delete: null
        );

        await ProfilePictures.InitialiseAsync();


        Locations = new ListDataSource<Location, int>(
            JS,
            StateHasChanged,
            GetPrimaryKey: x => x.Id,
            List: (int? skip, int? take, string[]? orderBy, CancellationToken ct) => LocationsApi.List(skip, take, orderBy, ct),
            SetForeignKey: null,
            AfterSaveAction: null,
            AfterCancelAction: null,
            Create: null,
            Read: LocationsApi.Read,
            Update: null,
            Delete: null
        );
        await Locations.InitialiseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Profile != null)
            await Profile.DisposeAsync();
        if (Locations != null)
            await Locations.DisposeAsync();
    }
}