@page "/profilepictures/delete/{id?}"
@implements IAsyncDisposable
@inject IProfilePicturesApi iProfilePicturesApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete ProfilePicture</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete ProfilePicture</h3>
        <LoaderView Response="ProfilePicture?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this ProfilePicture
            </div>

            <ProfilePictureDetails DataSource="ProfilePicture" />
            <ErrorView Response="ProfilePicture!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="ProfilePicture.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="ProfilePicture.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<ProfilePicture, Guid>? ProfilePicture;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        ProfilePicture = new ItemDataSource<ProfilePicture, Guid>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/profilepictures"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/profilepictures"),
            Create: null,
            Read: iProfilePicturesApi.Read,
            Update: null,
            Delete: iProfilePicturesApi.Delete,
            FileUpdate: null,
            FileDelete: iProfilePicturesApi.FileDelete
        );

        await ProfilePicture.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (ProfilePicture != null) 
            await ProfilePicture.DisposeAsync();
    }
}