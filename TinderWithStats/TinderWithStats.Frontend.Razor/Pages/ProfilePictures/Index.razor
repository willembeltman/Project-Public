@page "/profilepictures"
@implements IAsyncDisposable
@inject IProfilePicturesApi list
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS

<PageTitle>ProfilePictures</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>ProfilePictures</h3>
        <LoaderView Response="ProfilePictures?.Response">
            @if (ProfilePictures!.Response!.CanCreate)
            {
                <a id="createnew" href="/profilepictures/create">➕ Create a new profilepicture</a>
            }
            <AutoProfilePictureList DataSource="ProfilePictures" />
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private CancellationTokenSource? Cts;
    private ListDataSource<ProfilePicture, Guid>? ProfilePictures;

    protected override async Task OnInitializedAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false)
        {
            return;
        }

        ProfilePictures = new ListDataSource<ProfilePicture, Guid>(
            JS,
            StateHasChanged,
            GetPrimaryKey: profilepicture => profilepicture.Id,
            List: list.List,
            SetForeignKey: null,
            AfterSaveAction: null,
            AfterCancelAction: null,
            Create: null,
            Read: null,
            Update: null,
            Delete: null
        );

        await ProfilePictures.InitialiseAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (ProfilePictures != null)
            await ProfilePictures.DisposeAsync();
    }
}