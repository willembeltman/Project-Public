@page "/profiles/delete/{id?}"
@implements IAsyncDisposable
@inject IProfilesApi iProfilesApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete Profile</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete Profile</h3>
        <LoaderView Response="Profile?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this Profile
            </div>

            <AutoProfileDetails DataSource="Profile" />
            <ErrorView Response="Profile!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="Profile.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="Profile.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<Profile, Guid>? Profile;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        Profile = new ItemDataSource<Profile, Guid>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/profiles"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/profiles"),
            Create: null,
            Read: iProfilesApi.Read,
            Update: null,
            Delete: iProfilesApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );

        await Profile.LoadModelAsync(Guid.TryParse(id, out var guidId) ? guidId : null);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Profile != null) 
            await Profile.DisposeAsync();
    }
}