@using System.Reflection

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@GetAdditionalAssemblies()">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Razor.Layout.MainLayout)">
                <NotAuthorized>
                    <p>You are not authorized. <a href="/account/login">Go to login page</a></p>
                </NotAuthorized>
                <Authorizing>
                    <p>Checking authentication...</p>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Razor.Layout.MainLayout)">
                <p>Sorry, nothing found here.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private Assembly[] GetAdditionalAssemblies()
    {
        return [
            typeof(Razor.Layout.MainLayout).Assembly
        ];
    }
}