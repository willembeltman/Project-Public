@page "/locations/delete/{id:int?}"
@implements IAsyncDisposable
@inject ILocationsApi iLocationsApi
@inject IClientAuthenticatedHttpClient ClientAuthenticatedHttpClient
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Delete Location</PageTitle>

<AuthorizeView>
    <Authorized>
        <h3>Delete Location</h3>
        <LoaderView Response="Location?.Response">
            <div class="alert alert-warning">
                Are you sure you want to delete this Location
            </div>

            <AutoLocationDetails DataSource="Location" />
            <ErrorView Response="Location!.StatusResponse" />

            <button id="delete" class="btn btn-danger" @onclick="Location.HandleDelete">🗑️ Delete</button>
            <button id="cancel" class="btn btn-secondary ms-2" @onclick="Location.Cancel">Cancel</button>
        </LoaderView>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int? id { get; set; }

    private CancellationTokenSource? Cts;
    private ItemDataSource<Location, int>? Location;

    protected override async Task OnParametersSetAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }

        Cts = new CancellationTokenSource();

        if (await ClientAuthenticatedHttpClient.IsAuthenticatedAsync(Cts.Token) == false || id == null)
        {
            return;
        }

        Location = new ItemDataSource<Location, int>(
            GetPrimaryKey: item => item.Id,
            AfterSaveAction: item => NavigationManager.NavigateTo("/locations"),
            AfterCancelAction: item => NavigationManager.NavigateTo("/locations"),
            Create: null,
            Read: iLocationsApi.Read,
            Update: null,
            Delete: iLocationsApi.Delete,
            FileUpdate: null,
            FileDelete: null
        );

        await Location.LoadModelAsync(id);
    }

    public async ValueTask DisposeAsync()
    {
        if (Cts != null)
        {
            await Cts.CancelAsync();
            Cts.Dispose();
        }
        if (Location != null) 
            await Location.DisposeAsync();
    }
}